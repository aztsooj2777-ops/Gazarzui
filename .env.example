# ============================================================
#  Vercel → Project Settings → Environment Variables
#  (Зөвхөн /api/chat serverless функцэд хэрэгтэй. Заавал биш.)
# ============================================================

# Anthropic Claude API түлхүүр — console.anthropic.com дээр үүсгэнэ.
# Тохируулаагүй бол AI багш суурилагдсан мэдлэгийн сангаар ажиллана.
ANTHROPIC_API_KEY=

# Ашиглах загвар (заавал биш). Хоосон бол claude-opus-5.
CHAT_MODEL=

